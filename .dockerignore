# Runtime and user data must never be sent to the Docker builder.  The
# Dockerfile only copies explicit source paths, but excluding secrets from the
# build context also protects remote builders, caches and future COPY changes.
data/
backups/
.env
.env.*
!.env.example

# Основная модель капчи входит в образ; загруженные версии остаются локальными.
/models/**
!/models/captcha/
!/models/captcha/README.md
!/models/captcha/model.pt
!/models/captcha/charset.txt

# Local reverse-engineering and diagnostic artefacts.
probe_*.py
apks/
*.apk
*.apks
*.xapk
*.log

# Local tooling / VCS.
.git/
.github/
.venv/
build/
dist/
__pycache__/
*.pyc
